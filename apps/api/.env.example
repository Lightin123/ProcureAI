# Connection string for the hosted PostgreSQL development database.
# Copy this file to .env and set the real value. Never commit .env.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Set to "true" to enforce strict TLS certificate verification.
# Leave unset for hosted providers whose certificates do not chain locally.
DATABASE_SSL_STRICT=false

# Port the API listens on (defaults to 4000).
PORT=4000

# Base URL of the FastAPI AI service. Loopback in local development. In a
# deployment this is the AI service's own URL, and AI_SERVICE_TOKEN below is
# what keeps that URL from being usable by anyone who finds it.
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret presented to the AI service on every call, as X-Internal-Token.
# Must be identical to AI_SERVICE_TOKEN in the AI service's own environment.
# Backend-only: it is never sent to the browser and never appears in a build.
# Generate one with: node -e "console.log(crypto.randomUUID())"
# Required in production; leave unset locally to run without authentication.
AI_SERVICE_TOKEN=

# Synchronous analysis timeout in milliseconds (Milestone 3 uses no background jobs).
AI_SERVICE_TIMEOUT_MS=60000

# Password applied to every demo account by `npm run seed`. Choose your own
# value of at least 12 characters; this is a development convenience, never a
# production credential. If left unset the seed script generates a random
# password and prints it once. Re-running `npm run seed` resets the password.
SEED_DEMO_PASSWORD=

# Adds the Secure attribute to the session cookie. Leave unset in local
# development (plain http would drop a Secure cookie); defaults to true when
# NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# Session lifetimes. Idle expiry slides on each request; absolute expiry does not.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Comma-separated origins accepted on state-changing requests. Defaults to the
# Vite dev server and the API's own port.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Set to "production" in a deployment. It turns on the Secure cookie default and
# the start-up configuration check, and stops unhandled error text from being
# returned to the caller.
# NODE_ENV=production

# How many reverse proxies sit in front of this process. `request.ip` keys the
# login and registration rate limiters, so an untrusted proxy would make every
# caller share one address. "loopback" is correct locally. Behind a platform
# router set the hop count: 1 for the platform alone, 2 when a CDN or a site
# proxy also forwards the request. See docs/engineering/deployment.md.
TRUST_PROXY=loopback

# ---------------------------------------------------------------------------
# Uploaded document storage
# ---------------------------------------------------------------------------

# Where vendor compliance documents and response attachments are written.
# "local" is the filesystem driver and the only driver implemented.
STORAGE_DRIVER=local

# The directory the local driver writes into. Unset in development, where it
# defaults to apps/api/var/uploads.
#
# REQUIRED in production, and it must name a genuinely persistent, mounted path:
# a container filesystem is erased on every deploy, which would destroy every
# uploaded document while the database rows referencing them survive. The API
# refuses to start in production without it.
# UPLOAD_DIR=/var/data/uploads
