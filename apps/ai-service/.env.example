# Provider selection. Leave unset to auto-select:
#   AI_API_KEY present        -> "openai_compatible"
#   ANTHROPIC_API_KEY present -> "anthropic"
#   neither                   -> "stub"
# Set explicitly to override: "stub" | "anthropic" | "openai_compatible".
# AI_PROVIDER=openai_compatible

# ---------------------------------------------------------------------------
# OpenAI-compatible provider (Groq, xAI/Grok, OpenRouter, Together, Ollama...)
# ---------------------------------------------------------------------------
# These are deliberately named AI_* rather than OPENAI_*, so an unrelated
# ambient OPENAI_API_KEY on your machine is never picked up by mistake.
#
# Groq:      https://api.groq.com/openai/v1   (key starts with gsk_)
# xAI/Grok:  https://api.x.ai/v1              (key starts with xai-)
# Ollama:    http://localhost:11434/v1        (any non-empty key)
#
# AI_API_KEY=gsk_your_key_here
AI_BASE_URL=https://api.groq.com/openai/v1

# Confirm current model IDs at https://console.groq.com/docs/models, or list
# what your key can reach with GET {AI_BASE_URL}/models -- the catalogue
# changes, and a retired ID returns a 404 from the provider.
# Verified working on Groq free tier: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b.
AI_MODEL=openai/gpt-oss-120b

# Prompt + max_tokens together must fit the provider's per-minute token budget.
# Groq's free tier allows 8000 tokens/minute, so 8000 here makes a single
# request exceed it and the provider replies HTTP 413. Keep this at 3000 on a
# free tier; raise it only on a paid plan with a higher limit.
AI_MAX_TOKENS=3000

# Attempts allowed for the model to return schema-valid JSON before failing.
AI_MAX_ATTEMPTS=2

# Required only when the Anthropic provider is used. Never commit a real key.
# ANTHROPIC_API_KEY=sk-ant-...

# Model is configurable so it can be changed without touching provider code.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8000

# ---------------------------------------------------------------------------
# Embeddings (semantic vendor matching)
# ---------------------------------------------------------------------------
# Configured independently of the analysis provider above, because they are
# different capabilities: Anthropic serves analysis and has no embeddings API at
# all, and an AI_API_KEY set for Groq must not silently start billing per
# embedding. Only EMBEDDING_API_KEY opts in to a hosted model.
#
# Leave unset to auto-select:
#   EMBEDDING_API_KEY present -> "openai_compatible"
#   otherwise                 -> "local_onnx"
#
# Set explicitly to override:
#   local_onnx        a real sentence encoder running on CPU via fastembed.
#                     The default. No API key. Downloads ~90 MB once on first
#                     use, then works offline. 384 dimensions.
#   local_concept     the deterministic concept-space fallback. No download at
#                     all, so it works on a machine that has never had network
#                     access, but it generalises only over the built-in
#                     procurement lexicon in app/embeddings/concepts.py.
#                     Chosen automatically if local_onnx cannot be loaded.
#   openai_compatible a hosted embeddings endpoint.
# EMBEDDING_PROVIDER=local_onnx

# EMBEDDING_MODEL applies to local_onnx and openai_compatible alike.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Must equal the width of the vector() columns in the database. Changing it
# requires a migration and a full re-embed — see apps/api/migrations/007.
EMBEDDING_DIMENSIONS=384

# Hosted embeddings only. Never commit a real key.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# The service binds to loopback only; Express is its sole caller.
HOST=127.0.0.1
PORT=8000
